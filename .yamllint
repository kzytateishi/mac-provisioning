extends: default

ignore:
  - .ansible/

# comments-indentation / octal-values は ansible-lint が要求する値
rules:
  line-length: disable
  document-start: disable
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
